{
  "name": "campushub",
  "version": "1.0.0",
  "description": "CampusHub multi-tenant campus resource management backend",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "ts-node src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "seed": "ts-node src/scripts/seed.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src shared",
    "format": "prettier --write \"src/**/*.ts\" \"shared/**/*.ts\"",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "eslint": "^10.11.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "prettier": "^3.9.8",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "mongoose": "^9.10.1"
  }
}
